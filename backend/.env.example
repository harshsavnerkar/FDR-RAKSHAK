# FDR SmartGuard Environment Configuration Template
# NOTE: Never commit real credentials or production secrets to version control.
# Copy this file to `backend/.env` and configure appropriate local credentials.

# Database Connection (Replace placeholders with your PostgreSQL credentials)
# Format: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Server Binding
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# Administrator Authentication & Session Security
ADMIN_USERNAME=aicte_admin
ADMIN_EMAIL=admin@aicte-india.org
ADMIN_INITIAL_PASSWORD=AICTE@Admin2026!
SESSION_COOKIE_NAME=fdr_session_id
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
RECOVERY_TOKEN_EXPIRE_MINUTES=15

# Upload Storage Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
