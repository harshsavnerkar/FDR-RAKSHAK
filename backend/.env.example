# FDR SmartGuard Environment Configuration Template
# NOTE: Never commit real credentials or production secrets to version control.
# Copy this file to `backend/.env` and configure appropriate local credentials.

# Database Connection (Replace placeholders with your PostgreSQL credentials)
# Format: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Server Binding
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
